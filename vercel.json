{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/HanDongtest/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/HanDongtest/",
      "permanent": true
    },
    {
      "source": "/HanDongtest",
      "destination": "/HanDongtest/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/HanDongtest/",
      "destination": "/index.html"
    },
    {
      "source": "/HanDongtest/:path*",
      "destination": "/:path*"
    }
  ]
}
